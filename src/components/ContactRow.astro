---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import { externalLinkAttrs } from '../lib/links';

interface Props {
  icon: IconName;
  /** With a link, the whole row (icon and text) is the link. */
  href?: string;
  /** Screen-reader label, read before the content (the icon is hidden). */
  label?: string;
}

const { icon, href, label } = Astro.props;
const Row = href ? 'a' : 'div';
---

<li>
  <Row href={href} {...externalLinkAttrs(href)} class:list={['flex gap-2.5', href && 'group']}>
    <span
      class:list={[
        // 20 px icon on a 20 px text line: aligned with the first line, no offset.
        'flex size-5 shrink-0 items-center justify-center text-muted-foreground',
        href && 'transition-colors group-hover:text-primary',
      ]}
    >
      <Icon name={icon} size={20} />
    </span>
    <span class="min-w-0">
      {label && <span class="sr-only">{label}: </span>}
      <slot />
    </span>
  </Row>
</li>
