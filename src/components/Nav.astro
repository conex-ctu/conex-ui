---
import { langFromPath, localePath, stripLocale, type Lang } from '../lib/i18n';
import { navItems } from '../lib/site';
import { shellT } from '../lib/strings';

interface Props {
  /** row: inline (desktop header). stack: one item per line (mobile menu). */
  layout?: 'row' | 'stack';
  class?: string;
  lang?: Lang;
}

const { layout = 'row', class: className, lang = langFromPath(Astro.url.pathname) } = Astro.props;
const t = shellT(lang);
const current = stripLocale(Astro.url.pathname);
---

<nav aria-label={t('a11y.mainNav')} class={className}>
  <ul
    class:list={[
      layout === 'row'
        ? '-mx-1 flex items-center gap-x-5 px-1 py-1 whitespace-nowrap'
        : 'flex flex-col py-2 text-base',
    ]}
  >
    {
      navItems.map(({ path, label }) => {
        const active = current.startsWith(`/${path}`);
        // "page" only on the item's own page; "true" inside its section.
        const ariaCurrent = active ? (current === `/${path}` ? 'page' : 'true') : undefined;
        return (
          <li>
            <a
              href={localePath(lang, path)}
              aria-current={ariaCurrent}
              class:list={[
                // Active state by colour and underline only: a bolder weight would
                // change the item's width and shift the items after it.
                'decoration-2 underline-offset-[6px] hover:text-primary',
                // Full-width rows with a comfortable tap target in the mobile menu.
                layout === 'stack' && 'block py-2.5',
                active ? 'text-foreground underline decoration-primary' : 'text-muted-foreground',
              ]}
            >
              {t(label)}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
