---
import { langFromPath, type Lang } from '../lib/i18n';
import { shellT } from '../lib/strings';

interface Props {
  lang?: Lang;
}

const { lang = langFromPath(Astro.url.pathname) } = Astro.props;
const t = shellT(lang);
---

<!-- Hidden by CSS when JavaScript is off (see conex.css); otherwise shown from the first paint. -->
<button
  type="button"
  data-theme-toggle
  aria-label={t('theme.toggle')}
  title={t('theme.toggle')}
  class="grid cursor-pointer place-items-center rounded p-1 text-muted-foreground transition-[color,scale] hover:text-foreground active:scale-85 motion-reduce:active:scale-100"
>
  <!-- Both icons share one grid cell; switching theme turns one out and the other in. -->
  <!-- moon: shown in light mode -->
  <svg class="col-start-1 row-start-1 size-5 transition-[opacity,rotate,scale] duration-(--duration-reveal) ease-out-soft dark:scale-75 dark:rotate-90 dark:opacity-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
  <!-- sun: shown in dark mode -->
  <svg class="col-start-1 row-start-1 size-5 transition-[opacity,rotate,scale] duration-(--duration-reveal) ease-out-soft scale-75 -rotate-90 opacity-0 dark:scale-100 dark:rotate-0 dark:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
</button>

<script>
  const root = document.documentElement;
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)');

  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  // Keep every toggle on the page in sync, not just the one clicked.
  const sync = () => {
    for (const b of buttons) b.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  };
  sync();
  systemDark.addEventListener('change', sync);

  const setTheme = (next: 'light' | 'dark'): void => {
    root.dataset.theme = next;
    // Store only a choice that differs from the system; choosing the system
    // value again means "follow the system" from then on.
    try {
      if ((next === 'dark') === systemDark.matches) localStorage.removeItem('theme');
      else localStorage.setItem('theme', next);
    } catch {}
    sync();
  };

  for (const button of buttons) {
    button.addEventListener('click', () => setTheme(root.dataset.theme === 'dark' ? 'light' : 'dark'));
  }
</script>
